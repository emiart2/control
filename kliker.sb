GraphicsWindow.BackgroundColor = "White"
GraphicsWindow.CanResize = "False"

'OBRAZEK =====================================================
obrazek = ImageList.LoadImage("C:\Users\admin\Desktop\Emilka\small_basic\capibara.png")
